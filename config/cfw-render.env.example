# cfw-render worker config — every knob, commented.
# Load order (cr_load_config in bin/cfw-render-lib.sh):
#   /etc/cfw-render.env  (Linux box, optional)
#   → $CFW_RENDER_ENV    (default ~/.gsai/secrets/cfw-render.env)
#   → process env        (always wins over both files)
#
# Copy this file to ~/.gsai/secrets/cfw-render.env (chmod 600) for local/dev
# use, or to /etc/cfw-render.env on the box. NEVER commit a filled-in copy —
# this repo only ships the .example.

# ── Required ─────────────────────────────────────────────────────────────
# cfw-social base URL, e.g. https://app.cfw.social
CFW_API_BASE=

# The scoped render-worker credential (shape ^cfw_render_...). See
# cfw-social/docs/render-worker-auth.md §5 for issuance.
CFW_RENDER_WORKER_KEY=

# ── Concurrency (DECISION LOCKED 2026-07-09) ────────────────────────────
# Max parallel Director subprocesses per drainer tick. Conservative default
# so the render fleet never starves the 9 live brand gateways on hst.
CFW_RENDER_CONCURRENCY=1

# ── Paths ─────────────────────────────────────────────────────────────────
# Ephemeral scratch root (plan §9 layout: <scratch>/<brandSlug>/<orderId>/...).
# CONFIRM the exact volume against the live box before deploy (docs/deploy.md).
CFW_RENDER_SCRATCH=$HOME/cfw-render-scratch

# Drainer state: tick lock, journal.tsv, runs/*.out logs, cfw-render.log,
# and the stable worker-id file (see CFW_RENDER_WORKER_ID_FILE below).
CFW_RENDER_STATE_DIR=$HOME/.cfw-render

# Stable per-INSTALL worker identity file (doc §6.3). Seeded once by
# install.sh (uuidgen), lazily seeded by the worker if absent. Read as the
# claim identity (workerId) — a STABLE id, NOT hostname:$$ recomputed every
# 15-min oneshot tick, so CFW-V2-068's per-workerId circuit breaker can
# actually accumulate consecutiveFailures for a broken install. hostname:$$
# survives only as free-text log/forensic context. Default derives from
# CFW_RENDER_STATE_DIR; override only for unusual multi-worker-per-host setups.
CFW_RENDER_WORKER_ID_FILE=$HOME/.cfw-render/worker-id

# ── Deploy mode + skills sourcing (doc §4) — OPERATIONAL only, set ONCE at
# install time; NEVER the security boundary (the server enforces that via
# which credential family resolves — CFW_RENDER_WORKER_KEY vs a brand/user
# scoped RenderWorkerKey). ────────────────────────────────────────────────
# server = our own fleet (hst, global CFW_RENDER_WORKER_KEY).
# byoa   = a customer's own machine (brand/user-scoped RenderWorkerKey).
# install.sh --mode <server|byoa> writes this; default server.
CFW_RENDER_MODE=server

# Recipes + gate skills root. cfw-render is SELF-CONTAINED (self-contain
# refactor, 2026-09-01): the DEFAULT (leave this unset/blank) is the bundled
# in-repo skills/ directory — a source-synced, pinned copy of the recipes in
# config/recipes.json, produced by scripts/sync-skills.sh from ~/ecosystem/skills.
# See config/skills-version.json for the exact source commit it carries. There
# is NO bundle-vs-fetch switch and NO shared-box fallback anymore — the box
# carries its own recipes, so the Hermes box needs no render toolchain (the
# whole point of "make the box stateless"). Override this var ONLY for local
# recipe-development iteration, e.g.:
#   CFW_RENDER_SKILLS_DIR=/Users/you/ecosystem/skills
# Precedence (highest wins): this var (env or this file) > bundled skills/ in
# this repo (cr_default_skills_dir() in bin/cfw-render-lib.sh).
CFW_RENDER_SKILLS_DIR=

# ── Models ────────────────────────────────────────────────────────────────
# Director primary model. MUST be VISION-CAPABLE (it runs the c-vision-qa gate
# on rendered images). PROVEN prod default (2026-08-22): kimi-k3 via Ollama
# Cloud — vision+tools+thinking, no Anthropic key needed. Other vision-capable
# Ollama Cloud models: gemma4:31b, qwen3.5:397b, minimax-m3. NON-vision models
# (kimi-k2.7-code, glm-5.2) will fail the QA gate — do NOT use them here.
# (Requires the ANTHROPIC_BASE_URL Ollama routing block below.)
CFW_RENDER_DIRECTOR_MODEL=kimi-k3

# Comma-separated models the subagent helper (cfw-render-subagent.sh) accepts
# for GLM/Kimi fan-out grunt work.
CFW_RENDER_FANOUT_MODELS=glm-5.2,kimi-k2

# ── Watchdogs (seconds) — per taskOrder.kind ────────────────────────────
# Video renders run long; keep at/under the server's 30-min claim lease.
CFW_RENDER_TIMEOUT_VIDEO=1800
# Image (single card or carousel) renders are shorter.
CFW_RENDER_TIMEOUT_IMAGE=900

# ── Eval gate ─────────────────────────────────────────────────────────────
# How many gate FAILs before the Director calls block_render_order.
CFW_RENDER_GATE_FAIL_CAP=2

# ── Ollama Cloud (GLM/Kimi fan-out + Sonnet quota-failover) ─────────────
# The PROVEN production recipe lives in ollama-keys.env (OLLAMA_KEY_GOOFY_
# HUGLE_463_B, OLLAMA_KEY_RECURSING_PIKE_357), NOT zai.env (which holds
# unrelated z.ai creds — see README "Ollama keys vs zai.env" note).
CFW_RENDER_OLLAMA_KEYS_FILE=$HOME/.gsai/secrets/ollama-keys.env

# ── Director → Ollama Cloud routing (REQUIRED when DIRECTOR_MODEL is an Ollama
#    model like kimi-k3) ──────────────────────────────────────────────────────
# The `claude` CLI is the real Anthropic CLI; to serve a custom model it must be
# pointed at Ollama Cloud's Anthropic-compatible endpoint. Use ANTHROPIC_AUTH_TOKEN
# (Bearer), NOT ANTHROPIC_API_KEY. Token = one OLLAMA_KEY_* value from
# ollama-keys.env. PROVEN 2026-08-22.
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=          # paste an OLLAMA_KEY_* value from ollama-keys.env
ANTHROPIC_MODEL=kimi-k3
ANTHROPIC_SMALL_FAST_MODEL=kimi-k3
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ── Root worker guard ───────────────────────────────────────────────────────
# The drainer runs the Director as `claude --dangerously-skip-permissions`,
# which the CLI REFUSES under root/sudo unless IS_SANDBOX=1. The box worker runs
# as root, so this is REQUIRED (a dedicated VPS is an acceptable sandbox). Must
# be in the systemd EnvironmentFile — a manual `bash -lc` run won't inherit it.
IS_SANDBOX=1

# ── Operator fleet-enable surface (CFW-16) — NOT a box knob ───────────────
# bin/cfw-render-fleet.sh (a.k.a. `cfw-render-ctl.sh fleet …`) opts a brand
# in/out of the render fleet (Brand.renderFleetEnabled) using the cfw-social
# MASTER key. DO NOT put the master key in THIS file or on any render box — the
# box is stateless and minimally-scoped by design. The helper reads its config
# from a SEPARATE operator-only file, $CFW_RENDER_ADMIN_ENV (default
# ~/.gsai/secrets/cfw-render-admin.env), or the process env — never
# /etc/cfw-render.env. That operator file holds only:
#   CFW_API_BASE=https://app.cfw.social
#   CFW_MASTER_API_KEY=<the cfw-social master key — operator machine ONLY>
# See docs/deploy.md §6.1.

# ── Test seam ─────────────────────────────────────────────────────────────
# When set, the drainer runs THIS command instead of spawning a real `claude`
# Director (used by test/run-tests.sh against test/mock-server.py +
# test/fake-director.sh). Leave empty in production.
CFW_RENDER_DIRECTOR_CMD=
