{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CFW Render",
  "version": "0.1.0",
  "identifier": "social.cfw.render",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CFW Render",
        "width": 960,
        "height": 640,
        "visible": false
      },
      {
        "label": "panel",
        "url": "index.html#/panel",
        "width": 360,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "setup",
        "title": "Set up CFW Render",
        "url": "index.html#/setup",
        "width": 520,
        "height": 640,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/worker/": "worker/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBKEY",
      "endpoints": [
        "https://app.cfw.social/api/v1/desktop/latest.json"
      ]
    }
  }
}
