<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.cfw.render.plist — launchd template (macOS dev box / macOS render host).
  Placeholders {{PREFIX}}, {{ENV_FILE}}, {{HOME}}, {{WORKER_PATH}} are
  substituted by install/install.sh. NOT loaded by this task (AB-RNDR-WORKER
  is code-authoring only) — a human loads it later per docs/deploy.md.

  PATH (CFW-291): {{WORKER_PATH}} is computed once in install.sh by
  cr_resolve_worker_path — a *resolved* location for every required binary
  (curl/python3/node/npx/ffmpeg/ffprobe/magick/claude), not a guessed static
  list. See bin/cfw-render-lib.sh and DOZER-DESIGN-CFW-291.md.

  Cadence (M2-04, D89): kept alive. launchd starts the worker at login
  (RunAtLoad) and restarts it whenever it exits (KeepAlive), no sooner than
  ThrottleInterval seconds after the last start. The worker itself loops:
  one claim every 60 s while idle, re-fills freed slots at once while busy.
  The tick lock inside the worker stops a second copy from claiming.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cfw.render</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{PREFIX}}/bin/cfw-render.sh</string>
    <string>--loop</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CFW_RENDER_ENV</key>
    <string>{{ENV_FILE}}</string>
    <key>PATH</key>
    <string>{{WORKER_PATH}}</string>
  </dict>

  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/cfw-render.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/cfw-render.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
